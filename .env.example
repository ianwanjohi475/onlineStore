# ── SIR VERT ENTERPRISE — environment ─────────────────────────────
# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# ── Storage (pick ONE; the app picks the best available automatically) ──
#
# 1) Turso — hosted SQLite. RECOMMENDED for production.
#    Real tables, indexed lookups, safe concurrent orders, generous free tier,
#    and it works on Vercel (plain SQLite files cannot — the FS is read-only).
#    Create a DB at turso.tech, then set both:
# TURSO_DATABASE_URL="libsql://your-db-name-you.turso.io"
# TURSO_AUTH_TOKEN="your-token"
#
# 2) Vercel Blob — durable JSON storage, zero setup.
#    Connect a Blob store in Vercel and it injects this automatically.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
#
# 3) Nothing set → a local JSON file (data/store.json). Fine for local dev;
#    does NOT persist on Vercel.

# ── Admin ──
# Password for /admin. REQUIRED on Vercel: the live admin stays locked until
# this is set (locally it defaults to "admin123" for development only).
# ADMIN_PASSWORD="choose-a-strong-password"

# Optional: a dedicated secret for signing admin sessions (falls back to ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET="a-long-random-string"

# ── Customer accounts ──
# Secret used to sign customer sign-in cookies. Recommended: a long random string
# (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# If unset, a server-only token is used instead; customers may need to sign in
# again after a redeploy.
# AUTH_SECRET="a-long-random-string"
