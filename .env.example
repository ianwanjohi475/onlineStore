# ── SIR VERT ENTERPRISE — environment ─────────────────────────────
# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Database (Postgres / CockroachDB).
# Leave this UNSET to run on the local JSON file store (data/store.json) — handy for quick local dev.
# SET it to your CockroachDB connection string to use the real database.
# The app auto-creates its tables and seeds them on first run — no migration commands needed.
# DATABASE_URL="postgresql://user:password@host:26257/defaultdb?sslmode=verify-full"

# Admin password for the /admin dashboard (defaults to "admin123" if unset — change this in production!)
# ADMIN_PASSWORD="choose-a-strong-password"
